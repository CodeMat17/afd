# Copy to .env.local (and set the same values in Netlify).

# Convex — written by `yarn convex:dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Shared secret: set here AND in Convex (`npx convex env set CONVEX_SERVER_SECRET <value>`)
CONVEX_SERVER_SECRET=

# Cloudinary — all catalogue photos. Dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pesapal API 3.0 — sandbox keys from https://developer.pesapal.com
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# From `yarn pesapal:register-ipn`
PESAPAL_IPN_ID=

# Public base URL Pesapal redirects to / notifies (a tunnel URL when testing locally)
SITE_URL=http://localhost:3000

# Admin dashboard (/admin)
ADMIN_PASSWORD=
# At least 32 random characters
ADMIN_SESSION_SECRET=
